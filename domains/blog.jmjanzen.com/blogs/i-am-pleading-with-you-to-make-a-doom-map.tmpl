    <script>
        // Dear noscripters, this script is not essential. It just scrambles certain words, but the
        // information is still available in the title property of an element with the 'scramble'
        // class
        const m = {}
        function scramble (interval = 1000 * 16) {
            setTimeout(() => {
                const targets = document.getElementsByClassName('scramble');
                for (let i = 0; i < targets.length; i++) {
                    const target = targets[i];
                    const text = target.innerHTML;
                    const isFirstFetch = target.title.match(/^or\s/);
                    let words = [];

                    if (isFirstFetch) {
                        const newTitle = `${target.innerHTML} ${target.title}`;

                        target.setAttribute('title', newTitle)

                        // FIXME Right pad shorter words to length of longest
                        words = newTitle.split('or').map(x => x.trim())
                        m[i] = words;
                    } else {
                        words = m[i];
                    }

                    const word = words[Math.floor(Math.random() * words.length)];

                    target.innerHTML = word
                }

                scramble();

            }, interval);
        }

        document.addEventListener("DOMContentLoaded", scramble);
    </script>
